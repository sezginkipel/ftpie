# ftpie — example environment file.
# Copy to `.env` (gitignored) and adjust. Nothing here is required: ftpie runs
# with sane defaults and reads no secrets from the environment.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# `tracing`/`env_logger` filter for the Rust backend.
# Examples:
#   RUST_LOG=info
#   RUST_LOG=ftpie=debug,russh=warn,suppaftp=warn
#   RUST_LOG=trace                     # very noisy
RUST_LOG=info

# Emit a backtrace when the backend panics (1 = short, full = complete).
RUST_BACKTRACE=1

# ---------------------------------------------------------------------------
# Build (Windows)
# ---------------------------------------------------------------------------
# This checkout may live under a path containing a space, which breaks MinGW
# linking. Point cargo's output at a space-free directory. Prefer
# `build.target-dir` in .cargo/config.toml; this is the shell equivalent.
# CARGO_TARGET_DIR=C:/ftpie-target

# Prepend the MSYS2 MinGW toolchain when building the GNU fallback target.
# PATH=/c/msys64/mingw64/bin:$PATH

# ---------------------------------------------------------------------------
# Tauri
# ---------------------------------------------------------------------------
# Dev-server URL the shell loads in `tauri dev` (must match vite's port).
# TAURI_DEV_URL=http://localhost:5173

# Updater signing key, used ONLY by release tooling — never commit a real key.
# The updater is currently DISABLED (no endpoint configured); see README.
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ---------------------------------------------------------------------------
# NOT used for secrets
# ---------------------------------------------------------------------------
# AI provider API keys are stored in the encrypted vault via `ai_set_key`,
# NOT in environment variables and never in this file.
