{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ftpie-web",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },

  // The zone must already exist in this account; the record is created on deploy.
  "routes": [
    {
      "pattern": "ftpie.sadelabs.site",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true
  }
}
