{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    // Off deliberately: the only JavaScript here is the adapter's generated
    // `_worker.js` under `.svelte-kit/cloudflare`, and type-checking build
    // output produces a thousand meaningless errors. All source is TypeScript.
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler"
  }
}
