{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // A referenced project must emit; declarations go to a scratch dir that is
    // never shipped (the app build is driven by `vite build`, not tsc).
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
